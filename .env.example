# Supabase configuration for Google Sign-In.
# Copy this file to `.env` and fill in your own values. While these are empty,
# the app keeps running on the local demo provider and the Google button is disabled.

# Project URL from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=

# Use EITHER the anon (public) key OR the newer publishable key from the same page.
# Only one is required.
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
